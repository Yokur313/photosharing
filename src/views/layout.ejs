<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Photo Storage' %></title>
  <% if (typeof card !== 'undefined' && card) { %>
  <meta name="description" content="<%= card.description %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= card.siteName %>" />
  <meta property="og:title" content="<%= card.title %>" />
  <meta property="og:description" content="<%= card.description %>" />
  <meta property="og:url" content="<%= card.url %>" />
  <meta name="twitter:title" content="<%= card.title %>" />
  <meta name="twitter:description" content="<%= card.description %>" />
  <% if (card.image) { %>
  <meta property="og:image" content="<%= card.image %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="<%= card.image %>" />
  <% } else { %>
  <meta name="twitter:card" content="summary" />
  <% } %>
  <% } %>
  <link rel="stylesheet" href="/public/styles.css" />
  <script>
    (function(){
      const stored = localStorage.getItem('theme') || 'light';
      document.documentElement.dataset.theme = stored;
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <h1>Arthur Stainmesse Photo Storage</h1>
      <nav class="site-nav">
        <a href="https://yokur313.github.io/Photofolio/" target="_blank" rel="noopener">Portfolio</a>
        <a href="https://www.instagram.com/arthurstainmesse/" target="_blank" rel="noopener">Instagram</a>
        <details class="site-menu">
          <summary class="site-menu-summary">Menu</summary>
          <div class="site-menu-panel">
            <a href="/admin">Admin</a>
            <a href="/admin/shares">Shares</a>
            <a href="/viewer">Viewer</a>
          </div>
        </details>
        <button id="theme-toggle" class="secondary" type="button" aria-label="Toggle theme" title="Toggle theme">
          <span id="theme-icon">☀️</span>
        </button>
      </nav>
    </div>
  </header>
  <main class="container">
    <%- body %>
  </main>
  <script>
    (function(){
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      function setTheme(next){
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        var icon = document.getElementById('theme-icon');
        if (icon) icon.textContent = next === 'light' ? '☀️' : '🌙';
      }
      btn.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme || 'light';
        setTheme(cur === 'light' ? 'dark' : 'light');
      });
      // initialize icon
      setTheme(document.documentElement.dataset.theme || 'light');
    })();
  </script>
</body>
</html>


